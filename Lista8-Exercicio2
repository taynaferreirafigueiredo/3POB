public class Funcionario {
    
    protected String nome;
    protected double salarioBase;
    
    public Funcionario(String nome, double salarioBase) {
        this.nome = nome;
        this.salarioBase = salarioBase;
    }
    
    public double calcularSalario() {
        return salarioBase;
    }
    
    public String getNome() {
        return nome;
    }
}

class Gerente extends Funcionario {
    
    private double bonusFixo;
    
    public Gerente(String nome, double salarioBase, double bonusFixo) {
        super(nome, salarioBase);
        this.bonusFixo = bonusFixo;
    }
    
    @Override
    public double calcularSalario() {
        return salarioBase + bonusFixo;
    }
}

class Vendedor extends Funcionario {
    
    private double totalVendas;
    private double comissaoPercentual;
    
    public Vendedor(String nome, double salarioBase, double totalVendas, double comissaoPercentual) {
        super(nome, salarioBase);
        this.totalVendas = totalVendas;
        this.comissaoPercentual = comissaoPercentual;
    }
    
    @Override
    public double calcularSalario() {
        double comissao = totalVendas * (comissaoPercentual / 100);
        return salarioBase + comissao;
    }
}

public class Main {
    public static void main(String[] args) {
        Funcionario[] funcionarios = new Funcionario[3];
        
        funcionarios[0] = new Gerente("Carlos", 5000.0, 1500.0);
        funcionarios[1] = new Vendedor("Ana", 2000.0, 10000.0, 10.0);
        funcionarios[2] = new Funcionario("Pedro", 3000.0);
        
        double folhaTotal = 0;
        
        for (Funcionario f : funcionarios) {
            double salario = f.calcularSalario();
            System.out.println(f.getNome() + " -> Salario: " + salario);
            folhaTotal += salario;
        }
        
        System.out.println("------------------------------");
        System.out.println("Folha de pagamento total: " + folhaTotal);
    }
}
