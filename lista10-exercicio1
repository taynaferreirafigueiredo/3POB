import java.util.InputMismatchException;
import java.util.Scanner;

public class DivisaoSegura {

    public static void main(String[] args) {
        // Cria o Scanner para ler os dados do teclado
        Scanner scanner = new Scanner(System.in);

        try {
            // Pede os dois numeros para o usuario
            System.out.print("Digite o primeiro numero inteiro: ");
            int numero1 = scanner.nextInt();

            System.out.print("Digite o segundo numero inteiro: ");
            int numero2 = scanner.nextInt();

            // Faz a divisao (se numero2 for 0, lanca ArithmeticException)
            int resultado = numero1 / numero2;

            System.out.println("Resultado da divisao: " + resultado);

        } catch (ArithmeticException e) {
            // Cai aqui se tentar dividir por zero
            System.out.println("Erro: nao e possivel dividir por zero!");

        } catch (InputMismatchException e) {
            // Cai aqui se o usuario digitar letras em vez de numeros
            System.out.println("Erro: voce precisa digitar apenas numeros inteiros!");

        } finally {
            // O finally sempre executa, dando erro ou nao
            System.out.println("Operacao finalizada.");
            scanner.close(); // fecha o Scanner para liberar o recurso
        }
    }
}
