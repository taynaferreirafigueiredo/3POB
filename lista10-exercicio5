import java.io.IOException;

class ProcessamentoDadosException extends Exception {

    public ProcessamentoDadosException(String mensagem, Throwable causa) {
        super(mensagem, causa);
    }
}

class ServicoArquivo {

    public void processarArquivo(String caminho) throws ProcessamentoDadosException {
        try {
            if (caminho == null || caminho.isEmpty()) {
                throw new IOException("Caminho do arquivo nulo ou vazio");
            }

            // Simula uma falha de parsing em arquivos .txt
            if (caminho.endsWith(".txt")) {
                Integer.parseInt("abc");
            }

            System.out.println("Arquivo " + caminho + " processado com sucesso.");

        } catch (IOException e) {
            throw new ProcessamentoDadosException("Falha ao ler o arquivo", e);
        } catch (NumberFormatException e) {
            throw new ProcessamentoDadosException("Falha ao interpretar os dados do arquivo", e);
        }
    }
}

public class Exercicio5 {

    public static void main(String[] args) {
        ServicoArquivo servico = new ServicoArquivo();
        String[] caminhos = {"dados.csv", "", "notas.txt"};

        for (String caminho : caminhos) {
            try {
                servico.processarArquivo(caminho);
            } catch (ProcessamentoDadosException e) {
                System.out.println("Erro: " + e.getMessage());
                System.out.println("Causa: " + e.getCause().getMessage());
            }
        }
    }
}
