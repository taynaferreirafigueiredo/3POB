import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

// Classe Aluno no mesmo arquivo (sem "public")
class Aluno {
    private String nome;
    private String curso;
    private double notaFinal;

    public Aluno(String nome, String curso, double notaFinal) {
        this.nome = nome;
        this.curso = curso;
        this.notaFinal = notaFinal;
    }

    public String getNome() {
        return nome;
    }

    public String getCurso() {
        return curso;
    }

    public double getNotaFinal() {
        return notaFinal;
    }

    @Override
    public String toString() {
        return nome + " (" + notaFinal + ")";
    }
}

public class Exercicio3 {
    public static void main(String[] args) {

        // Lista com vários alunos de cursos diferentes
        List<Aluno> alunos = Arrays.asList(
                new Aluno("Ana", "Java", 9.0),
                new Aluno("Bruno", "Java", 6.5),
                new Aluno("Carla", "Python", 7.0),
                new Aluno("Daniel", "Python", 8.5),
                new Aluno("Eduarda", "Banco de Dados", 5.0),
                new Aluno("Felipe", "Banco de Dados", 7.5),
                new Aluno("Gabriela", "Java", 7.1)
        );

              Map<String, List<Aluno>> porCurso = alunos.stream()
                .collect(Collectors.groupingBy(a -> a.getCurso()));

        System.out.println("=== Alunos por curso ===");
        // Percorro o mapa só para imprimir (forEach do próprio Map)
        porCurso.forEach((curso, lista) -> System.out.println(curso + ": " + lista));

             //    Aprovado = nota > 7.0
        Map<Boolean, List<Aluno>> aprovacao = alunos.stream()
                .collect(Collectors.partitioningBy(a -> a.getNotaFinal() > 7.0));

        System.out.println();
        System.out.println("=== Aprovados (nota > 7.0) ===");
        System.out.println(aprovacao.get(true));

        System.out.println("=== Reprovados (nota <= 7.0) ===");
        System.out.println(aprovacao.get(false));
    }
}

