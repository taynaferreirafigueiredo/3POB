import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;

public class Exercicio3 {
    public static void main(String[] args) {
        Path caminho = Path.of("produtos.csv");
        double totalGeral = 0;

        try {
            List<String> linhas = Files.readAllLines(caminho);

            for (int i = 1; i < linhas.size(); i++) {
                String linha = linhas.get(i);

                if (linha.isBlank()) {
                    continue;
                }

                String[] campos = linha.split(",");

                try {
                    String nome = campos[0].trim();
                    int quantidade = Integer.parseInt(campos[1].trim());
                    double preco = Double.parseDouble(campos[2].trim());
                    double totalItem = quantidade * preco;

                    totalGeral += totalItem;
                    System.out.printf("%s: %d x %.2f = %.2f%n", nome, quantidade, preco, totalItem);
                } catch (NumberFormatException e) {
                    System.out.println("Linha " + (i + 1) + " ignorada (formato invalido): " + linha);
                } catch (ArrayIndexOutOfBoundsException e) {
                    System.out.println("Linha " + (i + 1) + " ignorada (campos faltando): " + linha);
                }
            }

            System.out.printf("Valor total do inventario: R$ %.2f%n", totalGeral);
        } catch (IOException e) {
            System.out.println("Erro ao ler o arquivo: " + e.getMessage());
        }
    }
}
